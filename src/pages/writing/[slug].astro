---
import { url } from '../../lib/url';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import config from '../../site.config';
import { posts, fmtDate } from '../../lib/content';

export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 230));
---
<Base title={post.data.title} description={post.data.description}>
  <a class="back" href={url('/writing')}>← writing</a>
  <article class="article view">
    <span class="tag">{post.data.kind}{post.data.draft && ' · draft'}</span>
    <h1>{post.data.title}</h1>
    <div class="by"><span>{config.name}</span><time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time><span>{minutes} min read</span></div>
    <div class="prose"><Content /></div>
  </article>
</Base>
